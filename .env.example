# DeshDarshan AI - Environment Configuration Example
# Copy this file to .env.local to configure custom local variables

# Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Optional Telemetry & Mapping Keys
# NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ONDC Beckn Network Sandbox Gateway (Simulated locally by default)
# NEXT_PUBLIC_BECKN_GATEWAY_URL=https://staging.gateway.becknprotocol.io
# NEXT_PUBLIC_BAP_ID=deshdarshan-bap.gov.in
# NEXT_PUBLIC_BPP_ID=deshdarshan-rural-bpp.gov.in
